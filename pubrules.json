{
  "kind": "service",
  "ci": {
    "with": {
      "setup": "python -m venv .venv && .venv/bin/pip install --quiet -r requirements.lock && npm ci --ignore-scripts",
      "test": "PATH=$PWD/.venv/bin:$PATH .venv/bin/python -m pytest -q && npx --no-install cucumber-js",
      "shellcheck": "with-secrets *.sh"
    }
  },
  "protect": {
    "checks": [
      "ci / passed",
      "integrations / scan"
    ],
    "tags": false
  },
  "mirror": {
    "wheels": "https://storage.sustenaut.eu/wheels",
    "terraform": "https://storage.sustenaut.eu/terraform",
    "pypi": "https://storage.sustenaut.eu/pypi"
  }
}
